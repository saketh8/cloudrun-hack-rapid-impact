func (h *handlers) searchStockoutMCP(ctx context.Context, req SearchStockoutRequest) (string, error) {

	projectID := h.c.GetDefaultProjectID()
	if projectID == "" {
		return "Could not determine GCP project. Please configure default project.", nil
	}

	var startTime, endTime time.Time
	var startValid, endValid bool

	if req.StartDate != "" {
		startTime, startValid = genericCore.ParseTime(req.StartDate)
		if !startValid {
			return "Invalid StartDate format.", nil
		}
	}

	if req.EndDate != "" {
		endTime, endValid = genericCore.ParseTime(req.EndDate)
		if !endValid {
			return "Invalid EndDate format.", nil
		}
	}

	// Default to GKE if not provided
	clusterType := genericCore.ClusterTypeGKE
	if strings.ToUpper(req.ClusterType) == "SLURM" {
		clusterType = genericCore.ClusterTypeSlurm
	}

	searchReq := genericCore.StockoutSearchRequest{
		ClusterType: clusterType,
		ClusterName: req.ClusterName,
		Zone:        req.Zone,
		StartTime:   startTime,
		EndTime:     endTime,
	}

	return genericCore.SearchStockoutErrors(
		ctx,
		projectID,
		searchReq,
		projectID,
	)
}
